# Supabase — crea un proyecto en https://supabase.com y copia estos valores
# desde Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Credenciales del panel de administración (fallback si no existen en admin_settings)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesión del panel. Usa una cadena larga y
# aleatoria (p.ej. `openssl rand -hex 32`). Si no se define, se usa la
# service-role key como fallback, pero conviene ponerlo explícito en producción.
ADMIN_SESSION_SECRET=

# Gmail SMTP — usa una contraseña de aplicación de Google, no la contraseña normal
GMAIL_USER=tu-cuenta@gmail.com
GMAIL_APP_PASSWORD=abcdabcdabcdabcd
# Opcional: nombre que verá quien recibe el correo
EMAIL_FROM=Rumba Liguria <tu-cuenta@gmail.com>

# Geoapify — autocompletado de direcciones (https://www.geoapify.com)
NEXT_PUBLIC_GEOAPIFY_KEY=tu-geoapify-key

# URL pública del sitio (usada en los emails)
NEXT_PUBLIC_SITE_URL=https://rumbaliguria.com
